{
  "version": 2,
  "functions": {
    "api/**/*.js": { "runtime": "nodejs22.x" }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/login", "dest": "/public/login.html" },
    { "src": "/register", "dest": "/public/register.html" },
    { "src": "/dashboard", "dest": "/public/dashboard.html" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/home", "dest": "/public/home.html" },
    { "src": "/company", "dest": "/public/home.html" },
    { "src": "/", "dest": "/public/home.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
